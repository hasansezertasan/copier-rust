blank_issues_enabled: false
contact_links:
  - name: Question or idea
    url: https://github.com/[[ github_user ]]/[[ github_repo_name ]]/discussions
    about: Ask a question or float an idea before filing an issue.
  - name: Security vulnerability
    url: https://github.com/[[ github_user ]]/[[ github_repo_name ]]/security/policy
    about: Please report vulnerabilities privately, following the security policy.
