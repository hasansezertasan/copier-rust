name: Release build check
# Builds and packages every release target without attesting or publishing, so a
# platform-specific break (shell, toolchain, packaging) shows up in a pull
# request instead of during a release. Keep the matrix in sync with release.yml.
on:
  workflow_dispatch:
  pull_request:
    branches: [main]
    # The draft guard below skips draft PRs, so leaving draft must start a run;
    # `ready_for_review` is not part of GitHub's default event types.
    types: [opened, synchronize, reopened, ready_for_review]
    paths:
      - .github/workflows/release.yml
      - .github/workflows/release-build-check.yml
      - .github/scripts/package-release.sh
      - Cargo.toml
      - Cargo.lock
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
permissions: {}
jobs:
  build:
    name: Build (${{ matrix.target }})
    if: ${{ github.event.pull_request.draft != true }}
    timeout-minutes: 30
    permissions:
      contents: read
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        include:
[% for t in targets %]
          - { target: [[ t ]], os: [[ target_runners[t].os ]], ext: [[ target_runners[t].ext ]] }
[% endfor %]
    env:
      TARGET: ${{ matrix.target }}
      EXT: ${{ matrix.ext }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
[% if apt_packages %]
      - name: Install system packages
        if: ${{ runner.os == 'Linux' }}
        run: sudo apt-get update && sudo apt-get install -y --no-install-recommends [[ apt_packages ]]
[% endif %]
      - name: Install toolchain
        shell: bash
        run: rustup toolchain install stable --profile minimal --target "$TARGET"
      - name: Build
        shell: bash
        run: cargo build --release --locked --target "$TARGET"
      - name: Package
        shell: bash
        run: bash .github/scripts/package-release.sh
      - name: Check the archive layout
        shell: bash
        run: |
          # One top-level directory holding the binary, as mise's github backend expects.
          if [ "$EXT" = "zip" ]; then
            7z l "dist/[[ bin_name ]]-${TARGET}.zip" | grep -E "[[ bin_name ]]-${TARGET}[/\\\\][[ bin_name ]]\.exe"
          else
            tar tzf "dist/[[ bin_name ]]-${TARGET}.tar.gz" | grep -x "[[ bin_name ]]-${TARGET}/[[ bin_name ]]"
          fi
          test -s "dist/[[ bin_name ]]-${TARGET}.${EXT}.sha256"
